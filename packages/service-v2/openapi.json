  "info": {
    "title": "Meter App Service V2",
    "description": "REST API for meter app",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateUnitDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Kilowattstunde"
          },
          "suffix": {
            "type": "string",
            "example": "kWh"
          }
        },
        "required": [
          "name",
          "suffix"
        ]
      },
      "UpdateUnitDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Kilowattstunde"
          },
          "suffix": {
            "type": "string",
            "example": "kWh"
          }
        }
      },
      "CreateMeterTypeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Strom"
          },
          "unitId": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "name",
          "unitId"
        ]
      },
      "UpdateMeterTypeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Strom"
          },
          "unitId": {
            "type": "number",
            "example": 1
          }
        }
      },
      "CreateMeterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Main electricity meter"
          },
          "meterTypeId": {
            "type": "number",
            "example": 2
          }
        },
        "required": [
          "name",
          "meterTypeId"
        ]
      },
      "UpdateMeterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Main electricity meter"
          },
          "meterTypeId": {
            "type": "number",
            "example": 2
          }
        }
      },
      "CreateValueDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "example": 1245.67
          },
          "timestamp": {
            "type": "string",
            "example": "2026-03-05T12:00:00.000Z"
          },
          "meterId": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "value",
          "timestamp",
          "meterId"
        ]
      },
      "UpdateValueDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "example": 1245.67
          },
          "timestamp": {
            "type": "string",
            "example": "2026-03-05T12:00:00.000Z"
          },
          "meterId": {
            "type": "number",
            "example": 1
          }
        }
      },
      "CreateNoteDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "example": "Yearly meter check done"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-03-05T12:00:00.000Z"
          }
        },
        "required": [
          "text",
          "timestamp"
        ]
      },
      "UpdateNoteDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "example": "Yearly meter check done"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-03-05T12:00:00.000Z"
          }
        }
      }
    }
